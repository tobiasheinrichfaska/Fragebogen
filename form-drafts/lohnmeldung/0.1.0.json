          ]
        },
        {
          "id": "agFirma",
          "role": "arbeitgeber",
          "type": "text",
          "label": "Firma des Arbeitgebers",
          "required": true,
          "purpose": "Zuordnung",
          "masterData": "firma"
        },
        {
          "id": "agBetriebsnummer",
          "role": "arbeitgeber",
          "type": "betriebsnummer",
          "label": "Betriebsnummer des Arbeitgebers",
          "required": true,
          "purpose": "Zuordnung",
          "masterData": "betriebsnummer"
        },
        {
          "id": "mandantennummer",
          "role": "arbeitgeber",
