          "required": true,
          "purpose": "Zuordnung variabler Bezüge zum Abrechnungszeitraum",
          "options": [
            {
              "id": "abrechnungsmonat",
              "label": "den Abrechnungsmonat"
            },
            {
              "id": "vormonat",
              "label": "den Vormonat (Abrechnung einen Monat später)"
