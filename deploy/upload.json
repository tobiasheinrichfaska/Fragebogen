{
  "zugang": "fragebogen",
  "targets": {
    "oeffentlich": {
      "description": "Öffentliche App im Hauptordner der Subdomain",
      "build": "build",
      "folder": "",
      "access": "public",
      "files": [
        { "from": "dist/index.html", "to": "index.html", "verify": true },
        { "from": "deploy/.htaccess", "to": ".htaccess" },
        { "from": "docs/hilfe/", "to": "hilfe/" }
      ]
    },
    "test": {
      "description": "Testbereich: Formular-Entwürfe, mit Übergabe an das Lohnprogramm (eure IPs oder Tester-Anmeldung)",
      "build": "build:test",
      "folder": "test",
      "access": "ipOrLogin",
      "allowMarkers": ["mapping"],
      "authName": "Fragebogen - Testbereich",
      "testers": "deploy/.local/tester.json",
      "files": [
        { "from": "dist-test/index.html", "to": "index.html", "verify": true },
        { "from": "docs/hilfe/", "to": "hilfe/" }
      ]
    },
    "mehrfachbearbeitung": {
      "description": "Mehrfachbearbeitung: Kanzlei-Fassung mit Übergabe an das Lohnprogramm (nur von den IP-Adressen der Kanzlei; vorerst nicht hochgeladen)",
      "build": "build:kanzlei",
      "folder": "mehrfachbearbeitung",
      "access": "ip",
      "allowMarkers": ["mapping"],
      "files": [{ "from": "dist-kanzlei/index.html", "to": "index.html", "verify": true }]
    },
    "regeln": {
      "description": "Nur die Regeln im Hauptordner der Subdomain (.htaccess) – die öffentliche App bleibt unverändert",
      "folder": "",
      "access": "public",
      "files": [{ "from": "deploy/.htaccess", "to": ".htaccess" }]
    }
  },
  "forbidden": ["dist-preview/", "config/", "import/", ".tmp/", "deploy/.local/"],
  "markers": [
    {
      "id": "mapping",
      "file": "config/export.local.json",
      "extract": "exportMasks",
      "label": "die Zuordnung zum Lohnprogramm"
    }
  ]
}
