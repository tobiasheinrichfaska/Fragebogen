[
  {
    "format": "fragebogen.export",
    "version": 1,
    "target": "LuG",
    "title": "Beispielprogramm",
    "form": "personalfragebogen",
    "howTo": ["Im Beispielprogramm: Datei | Einlesen."],
    "importVersion": "1.0",
    "special": {
      "mandantSel": "12; MandantSel; Nummer",
      "mitarbeiterSel": "14; MitarbeiterSel; Nummer",
      "mitarbeiterNeu": "13; MitarbeiterNeu; Nummer;Name;Vorname;Beginn;Monat"
    },
    "inputs": [
      {
        "id": "lohnart",
        "label": "Lohnart für das Gehalt",
        "digits": [1, 4],
        "when": {
          "field": "agEntgeltArt",
          "equals": "monatsentgelt"
        }
      },
      {
        "id": "kasse",
        "label": "Betriebsnummer der Krankenkasse",
        "digits": [8, 8],
        "when": {
          "field": "krankenversicherung",
          "equals": "gesetzlich"
        },
        "context": ["krankenkasse"],
        "options": [
          {
            "value": "12345678",
            "label": "Muster-BKK"
          },
          {
            "value": "87654321",
            "label": "Beispiel-Kasse"
          }
        ],
        "defaultFrom": {
          "field": "krankenkasse",
          "code": "betriebsnummer"
        }
      },
      {
        "id": "konfession",
        "label": "Konfession (Kürzel)",
        "options": [
          {
            "value": "ak",
            "label": "altkatholisch"
          },
          {
            "value": "is",
            "label": "israelitisch"
          }
        ],
        "when": {
          "field": "kirchensteuer",
          "equals": "andere"
        },
        "context": ["kirchensteuerAndere"]
      },
      {
        "id": "stelle",
        "label": "Kostenstelle",
        "digits": [1, 3],
        "default": "7"
      }
    ],
    "employee": {
      "number": {
        "field": "agPersonalnummer"
      },
      "name": {
        "field": "familienname"
      },
      "firstName": {
        "field": "vorname"
      },
      "start": {
        "field": "agBeschaeftigungsbeginn",
        "format": "date"
      },
      "firstMonth": {
        "field": "agBeschaeftigungsbeginn",
        "format": "month"
      }
    },
    "records": [
      {
        "mask": "Beispiel|Personal|Name",
        "fields": [
          {
            "name": "Nachname",
            "values": [
              {
                "field": "familienname"
              }
            ]
          },
          {
            "name": "Vorname",
            "values": [
              {
                "field": "vorname"
              }
            ]
          },
          {
            "name": "Land(Kennzeichen;Name)",
            "values": [
              {
                "field": "anschriftStaat",
                "code": "laenderkennzeichen"
              },
              {
                "field": "anschriftStaat"
              }
            ]
          },
          {
            "name": "Ort",
            "values": [
              {
                "field": "wohnort"
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Personal|Angaben",
        "fields": [
          {
            "name": "Geburtstag",
            "values": [
              {
                "field": "geburtsdatum",
                "format": "date"
              }
            ]
          },
          {
            "name": "Geschlecht",
            "values": [
              {
                "field": "geschlecht",
                "map": {
                  "maennlich": "m",
                  "weiblich": "w",
                  "divers": "d",
                  "unbestimmt": "x"
                }
              }
            ]
          },
          {
            "name": "Nationalitaet(Schluessel;Zusatz)",
            "values": [
              {
                "field": "staatsangehoerigkeitSchluessel",
                "code": "schluessel"
              },
              {
                "field": "titel",
                "optional": true
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|SV|Gruppen",
        "fields": [
          {
            "name": "BGS(Gueltig_ab;KV;RV;AV;PV)",
            "label": "Beitragsgruppen",
            "values": [
              {
                "field": "agBeschaeftigungsbeginn",
                "format": "month"
              },
              {
                "derivation": "beitragsgruppen",
                "slice": [0, 1]
              },
              {
                "derivation": "beitragsgruppen",
                "slice": [1, 2]
              },
              {
                "derivation": "beitragsgruppen",
                "slice": [2, 3]
              },
              {
                "derivation": "beitragsgruppen",
                "slice": [3, 4]
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Bank",
        "fields": [
          {
            "name": "IBAN",
            "values": [
              {
                "field": "iban"
              }
            ]
          },
          {
            "name": "Zahlungsart",
            "values": [
              {
                "field": "zahlungsweg",
                "map": {
                  "ueberweisung": "SEPA"
                }
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Minijob",
        "when": {
          "field": "agBeschaeftigungsart",
          "equals": "minijob"
        },
        "fields": [
          {
            "name": "Pauschal",
            "values": [
              {
                "field": "agPauschalsteuerAbgewaelzt",
                "format": "jn"
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Entgelt",
        "fields": [
          {
            "name": "Gehalt",
            "values": [
              {
                "field": "agMonatsentgelt",
                "format": "decimal"
              }
            ]
          },
          {
            "name": "Taetigkeit",
            "values": [
              {
                "field": "agTaetigkeit"
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Bezug",
        "fields": [
          {
            "name": "Lohnart",
            "values": [
              {
                "blank": true
              }
            ]
          },
          {
            "name": "Betrag",
            "values": [
              {
                "field": "agMonatsentgelt",
                "format": "decimal"
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Vertrag",
        "fields": [
          {
            "name": "Beitrag(Gueltig_ab;Lohnart;Betrag)",
            "values": [
              {
                "field": "agBeschaeftigungsbeginn",
                "format": "month"
              },
              {
                "blank": true
              },
              {
                "field": "agMonatsentgelt",
                "format": "decimal"
              }
            ]
          },
          {
            "name": "Ort",
            "values": [
              {
                "field": "wohnort"
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Historie",
        "fields": [
          {
            "name": "Nummer(Gueltig_ab;Nummer)",
            "values": [
              {
                "field": "agBeschaeftigungsbeginn",
                "format": "month",
                "companion": true
              },
              {
                "field": "versicherungsnummer"
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Gehalt",
        "when": {
          "field": "agEntgeltArt",
          "equals": "monatsentgelt"
        },
        "fields": [
          {
            "name": "Lohnart",
            "values": [
              {
                "input": "lohnart"
              }
            ]
          },
          {
            "name": "Betrag",
            "values": [
              {
                "field": "agMonatsentgelt",
                "format": "decimal"
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Kasse",
        "fields": [
          {
            "name": "Kasse(Gueltig_ab;Nummer)",
            "label": "Krankenkasse",
            "values": [
              {
                "field": "agBeschaeftigungsbeginn",
                "format": "month",
                "companion": true
              },
              {
                "input": "kasse"
              }
            ]
          },
          {
            "name": "Stelle",
            "values": [
              {
                "input": "stelle"
              }
            ]
          }
        ]
      },
      {
        "mask": "Beispiel|Steuer",
        "fields": [
          {
            "name": "Kfb",
            "values": [
              {
                "field": "kinderfreibetraege"
              }
            ]
          },
          {
            "name": "Konfession(Gueltig_ab;Kuerzel)",
            "values": [
              {
                "field": "agBeschaeftigungsbeginn",
                "format": "month",
                "companion": true
              },
              {
                "first": [
                  {
                    "input": "konfession"
                  },
                  {
                    "field": "kirchensteuer",
                    "map": {
                      "keine": "",
                      "ev": "ev",
                      "rk": "rk"
                    }
                  }
                ]
              }
            ],
            "label": "Konfession"
          }
        ]
      },
      {
        "mask": "Beispiel|Gruppe",
        "fields": [
          {
            "name": "PGS",
            "values": [
              {
                "derivation": "personengruppe",
                "map": {
                  "101": "101",
                  "119": "119",
                  "120": "120"
                },
                "notes": {
                  "120": "steht nicht in der Werteliste – im Protokoll prüfen"
                }
              }
            ]
          }
        ]
      }
    ]
  }
]
